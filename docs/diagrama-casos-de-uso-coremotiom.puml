@startuml
' CoreMotiom: diagrama de casos de uso do projeto atual.
' Para usar no Miro: + > PlantUML Diagrams > colar este arquivo > Add to board.
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 35
skinparam ranksep 50
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam actor {
  BorderColor #1E293B
  FontColor #0F172A
}
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #334155
  FontColor #0F172A
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #334155
  FontColor #0F172A
}
skinparam ArrowColor #475569

actor "Pessoa que navega" as NAV
actor "Visitante" as VIS
actor "Atleta cadastrado" as ATL
actor "Lojista" as LOJ
actor "Administrador" as ADM

rectangle "CoreMotiom — plataforma esportiva" {
  usecase "UC01\nConsultar e filtrar\nprodutos" as UC01
  usecase "UC02\nConsultar lojas" as UC02
  usecase "UC03\nLer publicações\nda comunidade" as UC03
  usecase "UC04\nConsultar\ntreinadores" as UC04
  usecase "UC05\nGerenciar carrinho" as UC05
  usecase "UC06\nFinalizar pedido\n(simulação)" as UC06

  usecase "UC07\nCadastrar conta" as UC07
  usecase "UC08\nEntrar na conta" as UC08
  usecase "UC09\nAnunciar produto C2C" as UC09
  usecase "UC10\nInteragir na\ncomunidade" as UC10
  usecase "UC17\nSalvar produto\ncomo favorito" as UC17

  usecase "UC11\nCadastrar loja" as UC11
  usecase "UC12\nSolicitar verificação\nda loja" as UC12

  usecase "UC13\nAnalisar verificação\nda loja" as UC13
  usecase "UC14\nGerenciar usuários" as UC14
  usecase "UC15\nModerar produtos" as UC15
  usecase "UC16\nAtualizar situação\nde pedidos (sandbox)" as UC16
}

' Generalização: o triângulo aponta para o ator genérico.
NAV <|-- VIS
NAV <|-- ATL
NAV <|-- LOJ
NAV <|-- ADM

' Associações: linhas simples entre atores e casos de uso.
NAV -- UC01
NAV -- UC02
NAV -- UC03
NAV -- UC04
NAV -- UC05
NAV -- UC06
VIS -- UC07
VIS -- UC08
ATL -- UC09
ATL -- UC10
ATL -- UC17
LOJ -- UC11
LOJ -- UC12
ADM -- UC13
ADM -- UC14
ADM -- UC15
ADM -- UC16

legend bottom
  UC06, PIX e atualização de pagamento: fluxos demonstrativos/sandbox.
  Consulta de treinadores não significa contratação efetiva.
endlegend
@enduml
